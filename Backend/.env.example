NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/sipantas_db?schema=public"

# CORS & Frontend
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# JWT & Auth
JWT_ACCESS_SECRET="replace_with_a_long_random_secret_min_32_chars"
JWT_REFRESH_SECRET="replace_with_another_long_random_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# TPS Collection Task
TPS_TASK_EXPIRES_HOURS=48

# WhatsApp Service (mock | fonnte | meta | etc.)
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_KEY=""
WHATSAPP_API_URL=""

# Initial Operator Seed (development/bootstrap only)
SEED_OPERATOR_NAME="Operator Si Pantas"
SEED_OPERATOR_USERNAME="operator"
SEED_OPERATOR_PASSWORD="ChangeMe123!"
